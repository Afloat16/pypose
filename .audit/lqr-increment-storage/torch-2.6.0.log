8ff"]}, "1c5cf51035629fd6447da334d41226eb1a04ab7e3563b4326d2895bdca02bd44": {"source": "def forward(self, x_init, time, current_u=None):\n        r'''\n        Performs LQR for the discrete system.\n\n        Args:\n            x_init (:obj:`Tensor`): The initial state of the system.\n            current_x (:obj:`Tensor`, optinal): The current states of the system along a\n                trajectory.\n            current_u (:obj:`Tensor`, optinal): The current inputs of the system along a\n                trajectory.\n            time (:obj:`Tensor`, optinal): The reference time step of the dynamical\n                system.\n\n        Returns:\n            List of :obj:`Tensor`: A list of tensors including the solved state sequence\n            :math:`\\mathbf{x}`, the solved input sequence :math:`\\mathbf{u}`, and the associated\n            quadratic costs :math:`\\mathbf{c}` over the time horizon.\n        '''\n        K, k = self.lqr_backward(x_init, time, current_u)\n        x, u, cost = self.lqr_forward(x_init, K, k)\n        return x, u, cost", "blobs": ["3a332cd35084393c73858c60e94896baf37ec351", "6f19a944d89a58600892565fafa0f856b382b8ff"]}, "e816a77434d67e8dd00d2bcd74d93cc7b7cf030cec897271c0bc3c407ef7c9ee": {"source": "def forward(self, x_init, current_x, current_u, time):\n        r'''\n        Performs LQR for the linear system.\n\n        Args:\n            x_init (:obj:`Tensor`): The initial state of the system.\n            current_x (:obj:`Tensor`, optinal): The current states of the system along a\n                trajectory.\n            current_u (:obj:`Tensor`, optinal): The current inputs of the system along a\n                trajectory.\n            time (:obj:`Tensor`, optinal): The reference time step of the dynamical\n                system.\n\n        Returns:\n            List of :obj:`Tensor`: A list of tensors including the solved state sequence\n            :math:`\\mathbf{x}`, the solved input sequence :math:`\\mathbf{u}`, and the associated\n            quadratic costs :math:`\\mathbf{c}` over the time horizon.\n        '''\n        K, k = self.lqr_backward(current_x, current_u, time)\n        x, u, cost = self.lqr_forward(x_init, current_x, current_u, K, k)\n        return x, u, cost", "blobs": ["f82639200f7927bb89a6c447675450ccd5e91446", "fb2c75169be280bc0eebe28dfc485e2218e1b6fe", "1450d438efd3f4973a865ac708a95a3219e4548b"]}, "b56166d7defe7d51b9518adeaf17ea1b3c1fc283a768f7c46c10297617c6ed6d": {"source": "def lqr_forward(self, x_init, current_x, current_u, K, k):\n\n        assert x_init.device == K.device == k.device\n        assert x_init.dtype == K.dtype == k.dtype\n        assert x_init.ndim == 2, \"Shape not compatible.\"\n\n        ns, nc = current_x.size(-1), current_u.size(-1)\n\n        u = torch.zeros(self.n_batch + (self.T, nc), dtype=self.p.dtype, device=self.p.device)\n        delta_u = torch.zeros(self.n_batch + (self.T, nc), dtype=self.p.dtype, device=self.p.device)\n        cost = torch.zeros(self.n_batch, dtype=self.p.dtype, device=self.p.device)\n        delta_xt = torch.zeros_like(x_init, dtype=x_init.dtype, device=self.p.device)\n        x = torch.zeros(self.n_batch + (self.T+1, ns), dtype=self.p.dtype, device=self.p.device)\n        x[..., 0, :] = x_init\n        xt = x_init\n\n        for t in range(self.T):\n            Kt, kt = K[...,t,:,:], k[...,t,:]\n            delta_u[..., t, :] = delta_ut = bmv(Kt, delta_xt) + kt\n            u[...,t,:] = ut = delta_ut + current_u[...,t,:]\n            xut = torch.cat((xt, ut), dim=-1)\n            x[...,t+1,:] = xt = self.system(xt, ut)[0]\n            if t < self.T-1:\n                delta_xt = (xt - current_x[...,t+1,:]).detach()\n            cost = cost + 0.5 * bvmv(xut, self.Q[...,t,:,:], xut) + (xut * self.p[...,t,:]).sum(-1)\n\n        return x[...,0:-1,:], u, cost", "blobs": ["f82639200f7927bb89a6c447675450ccd5e91446"]}, "27565c961120bbe4b0338b6326c300dc2f91254bcd7cf5c00b352c5a1cb7ed77": {"source": "def lqr_forward(self, x_init, current_x, current_u, K, k):\n\n        assert x_init.device == K.device == k.device\n        assert x_init.dtype == K.dtype == k.dtype\n        assert x_init.ndim == 2, \"Shape not compatible.\"\n\n        # Q: (n_batch*, T, N, N), p: (n_batch*, T, N), where n_batch* can be any batch dimensions, e.g., (2, 3)\n        n_batch = self.p.shape[:-2]\n        ns, nc = current_x.size(-1), current_u.size(-1)\n\n        u = torch.zeros(n_batch + (self.T, nc), dtype=self.p.dtype, device=self.p.device)\n        delta_u = torch.zeros(n_batch + (self.T, nc), dtype=self.p.dtype, device=self.p.device)\n        cost = torch.zeros(n_batch, dtype=self.p.dtype, device=self.p.device)\n        delta_xt = torch.zeros_like(x_init, dtype=x_init.dtype, device=self.p.device)\n        x = torch.zeros(n_batch + (self.T+1, ns), dtype=self.p.dtype, device=self.p.device)\n        x[..., 0, :] = x_init\n        xt = x_init\n\n        for t in range(self.T):\n            Kt, kt = K[...,t,:,:], k[...,t,:]\n            delta_u[..., t, :] = delta_ut = bmv(Kt, delta_xt) + kt\n            u[...,t,:] = ut = delta_ut + current_u[...,t,:]\n            xut = torch.cat((xt, ut), dim=-1)\n            x[...,t+1,:] = xt = self.system(xt, ut)[0]\n            if t < self.T-1:\n                delta_xt = (xt - current_x[...,t+1,:]).detach()\n            cost = cost + 0.5 * bvmv(xut, self.Q[...,t,:,:], xut) + (xut * self.p[...,t,:]).sum(-1)\n\n        return x[...,0:-1,:], u, cost", "blobs": ["fb2c75169be280bc0eebe28dfc485e2218e1b6fe", "1450d438efd3f4973a865ac708a95a3219e4548b"]}, "077202ee8822f5a6605b071f5540db92c7c56a6ef177da1af7489df5ade604ab": {"source": "def forward(self, x_init, current_x=None, current_u=None, time=None):\n        r'''\n        Performs LQR for the linear system.\n\n        Args:\n            x_init (:obj:`Tensor`): The initial state of the system.\n            current_x (:obj:`Tensor`, optinal): The current states of the system along a\n                trajectory. Default: ``None``.\n            current_u (:obj:`Tensor`, optinal): The current inputs of the system along a\n                trajectory. Default: ``None``.\n            time (:obj:`Tensor`, optinal): The reference time step of the dynamical\n                system. Default: ``None``.\n\n        Returns:\n            List of :obj:`Tensor`: A list of tensors including the solved state sequence\n            :math:`\\mathbf{x}`, the solved input sequence :math:`\\mathbf{u}`, and the associated\n            quadratic costs :math:`\\mathbf{c}` over the time horizon.\n        '''\n        K, k = self.lqr_backward(current_x, current_u, time)\n        x, u, cost = self.lqr_forward(x_init, current_x, current_u, K, k)\n        return x, u, cost", "blobs": ["46203e2214e1580bb33f09b3e14f482d1753f0f9"]}, "15ffa9a950581af574542892d3d47d8a7eef900820d865178763f5463d2c328c": {"source": "def lqr_forward(self, x_init, current_x, current_u, K, k):\n\n        assert x_init.device == K.device == k.device\n        assert x_init.dtype == K.dtype == k.dtype\n        assert x_init.ndim == 2, \"Shape not compatible.\"\n\n        # Q: (n_batch*, T, N, N), p: (n_batch*, T, N), where n_batch* can be any batch dimensions, e.g., (2, 3)\n        n_batch = self.p.shape[:-2]\n        if current_x is not None:\n            ns, nc = current_x.size(-1), current_u.size(-1)\n        else:\n            ns, nc = self.system.B.size(-2), self.system.B.size(-1)\n\n        u = torch.zeros(n_batch + (self.T, nc), dtype=self.p.dtype, device=self.p.device)\n        delta_u = torch.zeros(n_batch + (self.T, nc), dtype=self.p.dtype, device=self.p.device)\n        cost = torch.zeros(n_batch, dtype=self.p.dtype, device=self.p.device)\n        delta_xt = torch.zeros_like(x_init, dtype=x_init.dtype, device=self.p.device)\n        x = torch.zeros(n_batch + (self.T+1, ns), dtype=self.p.dtype, device=self.p.device)\n        x[..., 0, :] = x_init\n        xt = x_init\n\n        for t in range(self.T):\n            Kt, kt = K[...,t,:,:], k[...,t,:]\n            delta_u[..., t, :] = delta_ut = bmv(Kt, delta_xt) + kt\n            if current_x is None:\n                u[...,t,:] = ut = delta_ut + bmv(Kt, xt)\n            else:\n                u[...,t,:] = ut = delta_ut + current_u[...,t,:]\n            xut = torch.cat((xt, ut), dim=-1)\n            x[...,t+1,:] = xt = self.system(xt, ut)[0]\n            cost = cost + 0.5 * bvmv(xut, self.Q[...,t,:,:], xut) + (xut * self.p[...,t,:]).sum(-1)\n\n        return x[...,0:-1,:], u, cost", "blobs": ["46203e2214e1580bb33f09b3e14f482d1753f0f9", "6cd6b8ad0c025784e07e863c38ad4623bff7bcd1", "b8595efe233b4a595650ff2eae38d8075fb2fd87"]}, "6ae3b9079fb079f96deca968fec3a4cf341e1704683beb691dbc451791efb993": {"source": "def forward(self, x_init, current_x=None, current_u=None, time=None):\n        r'''\n        Performs LQR for the linear system.\n\n        Args:\n            x_init (:obj:`Tensor`): The initial state of the system.\n            current_x (:obj:`Tensor`, optinal): The current states of the system along a\n                trajectory.\n            current_u (:obj:`Tensor`, optinal): The current inputs of the system along a\n                trajectory.\n            time (:obj:`Tensor`, optinal): The reference time step of the dynamical system.\n\n        Returns:\n            List of :obj:`Tensor`: A list of tensors including the solved state sequence\n            :math:`\\mathbf{x}`, the solved input sequence :math:`\\mathbf{u}`, and the associated\n            quadratic costs :math:`\\mathbf{c}` over the time horizon.\n        '''\n        K, k = self.lqr_backward(current_x, current_u, time)\n        x, u, cost = self.lqr_forward(x_init, current_x, current_u, K, k)\n        return x, u, cost", "blobs": ["6cd6b8ad0c025784e07e863c38ad4623bff7bcd1"]}, "825795ff54a9d156b0b3c154396d9ee15d643cab29e2ed409ae74f9f8ec34521": {"source": "def forward(self, x_init, current_x=None, current_u=None, time=None):\n        r'''\n        Performs LQR for the linear system.\n\n        Args:\n            x_init (:obj:`Tensor`): The initial state of the system.\n\n        Returns:\n            List of :obj:`Tensor`: A list of tensors including the solved state sequence\n            :math:`\\mathbf{x}`, the solved input sequence :math:`\\mathbf{u}`, and the associated\n            quadratic costs :math:`\\mathbf{c}` over the time horizon.\n        '''\n        K, k = self.lqr_backward(current_x, current_u, time)\n        x, u, cost = self.lqr_forward(x_init, current_x, current_u, K, k)\n        return x, u, cost", "blobs": ["b8595efe233b4a595650ff2eae38d8075fb2fd87", "edf498e640b39ac8f05fc5de1c8c1ed52249b40b"]}, "4b542ff8785f002e3f69574fb134cc87526518263883a8a5b5aeb5d51450a292": {"source": "def lqr_forward(self, x_init, current_x, current_u, K, k):\n\n        assert x_init.device == K.device == k.device\n        assert x_init.dtype == K.dtype == k.dtype\n        assert x_init.ndim == 2, \"Shape not compatible.\"\n        B = self.p.shape[:-2]\n        ns, nc = self.system.B.size(-2), self.system.B.size(-1)\n        u = torch.zeros(B + (self.T, nc), dtype=self.p.dtype, device=self.p.device)\n        delta_u = torch.zeros(B + (self.T, nc), dtype=self.p.dtype, device=self.p.device)\n        cost = torch.zeros(B, dtype=self.p.dtype, device=self.p.device)\n        delta_xt = torch.zeros_like(x_init, dtype=x_init.dtype, device=self.p.device)\n        x = torch.zeros(B + (self.T+1, ns), dtype=self.p.dtype, device=self.p.device)\n        x[..., 0, :] = x_init\n        xt = x_init\n\n        self.system.set_refpoint(t=0)\n        for t in range(self.T):\n            Kt, kt = K[...,t,:,:], k[...,t,:]\n            delta_ut = bmv(Kt, delta_xt) + kt\n            delta_u[..., t, :] = delta_ut.clone()\n            #current_ut = current_u[...,t,:].clone()\n            if current_x is None:\n                u[...,t,:] = ut = delta_ut + bmv(Kt, xt)\n            else:\n                current_ut = current_u[...,t,:].clone()\n                u[...,t,:] = ut = del